{
  "name": "krishi-seva", "private": true, "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "npm run build && python3 -m http.server 3000 --directory dist --bind 0.0.0.0",
    "test": "node --test tests/backend.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-krishi-seva --only firestore 'node --test tests/rules.test.cjs'",
    "emulators": "npm run build && firebase emulators:start --project demo-krishi-seva",
    "deploy": "npm run build && firebase deploy",
    "bootstrap:admin": "node scripts/bootstrap-admin.cjs"
  },
  "devDependencies": {"@firebase/rules-unit-testing": "^4.0.1", "firebase": "^11.10.0", "firebase-tools": "^14.17.0", "@playwright/test": "^1.55.0"}
}
