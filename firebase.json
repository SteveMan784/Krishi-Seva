{
  "functions": [{"source": "functions", "codebase": "default", "runtime": "nodejs22"}],
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"},
  "hosting": {
    "public": "dist", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}, {"source": "/js/firebase-config.js", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
  },
  "emulators": {"auth": {"port": 9099}, "firestore": {"port": 8080}, "functions": {"port": 5001}, "hosting": {"port": 5000}, "ui": {"enabled": false}, "singleProjectMode": true}
}
